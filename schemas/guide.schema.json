{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HowTo guide",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "category",
    "subcategory",
    "personas",
    "age_groups",
    "occupations",
    "scenarios",
    "region",
    "difficulty",
    "estimated_time",
    "cost",
    "evidence_level",
    "content_type",
    "risk_level",
    "status",
    "created_at",
    "updated_at",
    "review_due",
    "sources",
    "life_stages",
    "prerequisites",
    "last_verified_at",
    "version",
    "claim_evidence",
    "execution_status"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^howto-[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "category": {
      "enum": [
        "life",
        "learning",
        "ai",
        "digital",
        "work"
      ]
    },
    "subcategory": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "personas": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "age_groups": {
      "type": "array",
      "items": {
        "enum": [
          "0-12",
          "13-17",
          "18-24",
          "25-34",
          "35-44",
          "45-59",
          "60+",
          "unknown"
        ]
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "occupations": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "scenarios": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "region": {
      "enum": [
        "global",
        "china-mainland",
        "singapore",
        "united-states",
        "eu",
        "united-kingdom",
        "unknown"
      ]
    },
    "difficulty": {
      "enum": [
        "beginner",
        "intermediate",
        "advanced"
      ]
    },
    "estimated_time": {
      "type": "string",
      "minLength": 1
    },
    "cost": {
      "type": "string",
      "minLength": 1
    },
    "evidence_level": {
      "enum": [
        "A",
        "B",
        "C",
        "pending"
      ]
    },
    "content_type": {
      "const": "howto"
    },
    "risk_level": {
      "enum": [
        "low",
        "medium",
        "high"
      ]
    },
    "status": {
      "enum": [
        "idea",
        "needs-research",
        "draft",
        "editorial-review",
        "expert-review",
        "published",
        "needs-update",
        "retired"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date"
    },
    "updated_at": {
      "type": "string",
      "format": "date"
    },
    "review_due": {
      "type": "string",
      "format": "date"
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uri",
        "pattern": "^https://"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "life_stages": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "prerequisites": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "last_verified_at": {
      "anyOf": [
        {
          "type": "string",
          "format": "date"
        },
        {
          "const": "pending"
        }
      ]
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+(?:\\.\\d+)?$"
    },
    "claim_evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "claim_id",
          "claim_text",
          "claim_type",
          "supporting_source_ids",
          "support_level",
          "source_location",
          "applicable_region",
          "applicable_version",
          "limitations",
          "reviewer_status"
        ],
        "properties": {
          "claim_id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "claim_text": {
            "type": "string",
            "minLength": 1
          },
          "claim_type": {
            "enum": [
              "fact",
              "recommendation",
              "experience",
              "inference",
              "hypothesis"
            ]
          },
          "supporting_source_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
            },
            "minItems": 0,
            "uniqueItems": true
          },
          "support_level": {
            "enum": [
              "direct",
              "partial",
              "indirect",
              "conflicting",
              "unsupported"
            ]
          },
          "source_location": {
            "type": "string",
            "minLength": 1
          },
          "applicable_region": {
            "enum": [
              "global",
              "china-mainland",
              "singapore",
              "united-states",
              "eu",
              "united-kingdom",
              "unknown"
            ]
          },
          "applicable_version": {
            "type": "string",
            "minLength": 1
          },
          "limitations": {
            "type": "string",
            "minLength": 1
          },
          "reviewer_status": {
            "enum": [
              "pending",
              "editorial-checked",
              "expert-approved"
            ]
          }
        }
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "execution_status": {
      "enum": [
        "pending",
        "tested"
      ]
    },
    "expert_review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "reference"
      ],
      "properties": {
        "status": {
          "enum": [
            "pending",
            "approved"
          ]
        },
        "reference": {
          "anyOf": [
            {
              "type": "string",
              "format": "uri",
              "pattern": "^https://"
            },
            {
              "const": "pending"
            }
          ]
        },
        "reviewed_at": {
          "type": "string",
          "format": "date"
        },
        "reviewer_role": {
          "type": "string",
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "approved"
              }
            }
          },
          "then": {
            "required": [
              "reviewer_role",
              "reviewed_at"
            ],
            "properties": {
              "reference": {
                "type": "string",
                "format": "uri",
                "pattern": "^https://"
              }
            }
          }
        }
      ]
    },
    "execution_record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tested_at",
        "environment",
        "result"
      ],
      "properties": {
        "tested_at": {
          "type": "string",
          "format": "date"
        },
        "environment": {
          "type": "string",
          "minLength": 1
        },
        "result": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "risk_level": {
            "const": "high"
          }
        }
      },
      "then": {
        "required": [
          "expert_review"
        ],
        "properties": {
          "status": {
            "enum": [
              "expert-review",
              "needs-update",
              "retired",
              "published"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "published"
          }
        }
      },
      "then": {
        "properties": {
          "evidence_level": {
            "enum": [
              "A",
              "B"
            ]
          },
          "region": {
            "not": {
              "const": "unknown"
            }
          },
          "last_verified_at": {
            "type": "string",
            "format": "date"
          },
          "execution_status": {
            "const": "tested"
          },
          "claim_evidence": {
            "items": {
              "properties": {
                "reviewer_status": {
                  "enum": [
                    "editorial-checked",
                    "expert-approved"
                  ]
                }
              }
            }
          }
        },
        "required": [
          "execution_record"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "risk_level": {
            "const": "high"
          },
          "status": {
            "const": "published"
          }
        }
      },
      "then": {
        "properties": {
          "expert_review": {
            "properties": {
              "status": {
                "const": "approved"
              },
              "reference": {
                "type": "string",
                "format": "uri",
                "pattern": "^https://"
              }
            }
          }
        }
      }
    }
  ]
}
