{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HowTo guide",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "category",
    "subcategory",
    "personas",
    "age_groups",
    "occupations",
    "scenarios",
    "region",
    "difficulty",
    "estimated_time",
    "cost",
    "evidence_level",
    "content_type",
    "risk_level",
    "status",
    "created_at",
    "updated_at",
    "review_due",
    "sources"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^howto-[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "category": {
      "enum": [
        "life",
        "learning",
        "ai",
        "digital",
        "work"
      ]
    },
    "subcategory": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "personas": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "age_groups": {
      "type": "array",
      "items": {
        "enum": [
          "0-12",
          "13-17",
          "18-24",
          "25-34",
          "35-44",
          "45-59",
          "60+"
        ]
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "occupations": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "scenarios": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "region": {
      "type": "string",
      "minLength": 1
    },
    "difficulty": {
      "enum": [
        "beginner",
        "intermediate",
        "advanced"
      ]
    },
    "estimated_time": {
      "type": "string",
      "minLength": 1
    },
    "cost": {
      "type": "string",
      "minLength": 1
    },
    "evidence_level": {
      "enum": [
        "A",
        "B",
        "C"
      ]
    },
    "content_type": {
      "const": "howto"
    },
    "risk_level": {
      "enum": [
        "low",
        "medium",
        "high"
      ]
    },
    "status": {
      "enum": [
        "draft",
        "review-required",
        "stable",
        "published",
        "retired"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date"
    },
    "updated_at": {
      "type": "string",
      "format": "date"
    },
    "review_due": {
      "type": "string",
      "format": "date"
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uri",
        "pattern": "^https://"
      },
      "minItems": 1,
      "uniqueItems": true
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "risk_level": {
            "const": "high"
          }
        }
      },
      "then": {
        "properties": {
          "status": {
            "enum": [
              "review-required",
              "retired"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "stable",
              "published"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "evidence_level": {
            "enum": [
              "A",
              "B"
            ]
          }
        }
      }
    }
  ]
}
