{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "V2.1 resource discovery record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "resource_id",
    "title",
    "alternative_titles",
    "canonical_url",
    "aliases",
    "source_platform",
    "source_repository",
    "publisher",
    "resource_type",
    "primary_domain",
    "domains",
    "topics",
    "language",
    "region",
    "jurisdiction",
    "audience",
    "life_stage",
    "skill_level",
    "format",
    "parent_resource_id",
    "child_resource_ids",
    "child_item_count",
    "description",
    "prerequisites",
    "cost_model",
    "license",
    "github_metrics",
    "provenance",
    "structure",
    "link_check",
    "status",
    "legacy_v2",
    "risk_level",
    "screening",
    "quality_assessment"
  ],
  "properties": {
    "schema_version": {
      "const": "2.1"
    },
    "resource_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "alternative_titles": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "canonical_url": {
      "type": "string",
      "format": "uri",
      "pattern": "^https?://"
    },
    "aliases": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uri",
        "pattern": "^https?://"
      },
      "uniqueItems": true
    },
    "source_platform": {
      "enum": [
        "github",
        "gitlab",
        "web"
      ]
    },
    "source_repository": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "publisher": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "resource_type": {
      "enum": [
        "howto_series",
        "practical_guide",
        "handbook",
        "manual",
        "cookbook",
        "playbook",
        "field_guide",
        "tutorial",
        "learning_path",
        "curriculum",
        "course",
        "cheatsheet",
        "wiki",
        "book",
        "official_reference",
        "awesome_list",
        "resource_directory",
        "collection",
        "bibliography",
        "tool",
        "community",
        "dataset",
        "unknown"
      ]
    },
    "primary_domain": {
      "enum": [
        "life",
        "health-safety",
        "finance-law-consumer",
        "learning-study",
        "digital-life",
        "career-work",
        "ai-everyone",
        "ai-engineering",
        "creative-hobby",
        "professional"
      ]
    },
    "domains": {
      "type": "array",
      "items": {
        "enum": [
          "life",
          "health-safety",
          "finance-law-consumer",
          "learning-study",
          "digital-life",
          "career-work",
          "ai-everyone",
          "ai-engineering",
          "creative-hobby",
          "professional"
        ]
      },
      "uniqueItems": true
    },
    "topics": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "language": {
      "type": "string",
      "pattern": "^(unknown|[A-Za-z]{2,3}(?:-[A-Za-z0-9]{2,8})*)$"
    },
    "region": {
      "type": "string",
      "pattern": "^(unknown|global|[A-Z]{2})$"
    },
    "jurisdiction": {
      "type": "string",
      "minLength": 1
    },
    "audience": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "life_stage": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "skill_level": {
      "enum": [
        "beginner",
        "intermediate",
        "advanced",
        "expert",
        "all-levels",
        "unknown"
      ]
    },
    "format": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "parent_resource_id": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        {
          "type": "null"
        }
      ]
    },
    "child_resource_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      },
      "uniqueItems": true
    },
    "child_item_count": {
      "type": "integer",
      "minimum": 0
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "prerequisites": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "cost_model": {
      "type": "string",
      "minLength": 1
    },
    "license": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "spdx_id",
        "license_url",
        "status",
        "content_reuse_allowed",
        "limitations",
        "observed_files"
      ],
      "properties": {
        "spdx_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "license_url": {
          "anyOf": [
            {
              "type": "string",
              "format": "uri",
              "pattern": "^https?://"
            },
            {
              "type": "null"
            }
          ]
        },
        "status": {
          "enum": [
            "verified",
            "unclear",
            "no_license_found",
            "proprietary",
            "mixed",
            "unknown"
          ]
        },
        "content_reuse_allowed": {
          "type": "boolean"
        },
        "limitations": {
          "type": "string",
          "minLength": 1
        },
        "observed_files": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    },
    "github_metrics": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "repository_id",
            "full_name",
            "stars",
            "forks",
            "open_issues",
            "created_at",
            "pushed_at",
            "updated_at",
            "archived",
            "default_branch",
            "fork",
            "metadata_checked_at"
          ],
          "properties": {
            "repository_id": {
              "type": "integer",
              "minimum": 0
            },
            "full_name": {
              "type": "string",
              "minLength": 1
            },
            "stars": {
              "type": "integer",
              "minimum": 0
            },
            "forks": {
              "type": "integer",
              "minimum": 0
            },
            "open_issues": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0
                },
                {
                  "type": "null"
                }
              ]
            },
            "created_at": {
              "anyOf": [
                {
                  "anyOf": [
                    {
                      "type": "string",
                      "format": "date-time"
                    },
                    {
                      "type": "string",
                      "format": "date"
                    }
                  ]
                },
                {
                  "type": "null"
                }
              ]
            },
            "pushed_at": {
              "anyOf": [
                {
                  "anyOf": [
                    {
                      "type": "string",
                      "format": "date-time"
                    },
                    {
                      "type": "string",
                      "format": "date"
                    }
                  ]
                },
                {
                  "type": "null"
                }
              ]
            },
            "updated_at": {
              "anyOf": [
                {
                  "anyOf": [
                    {
                      "type": "string",
                      "format": "date-time"
                    },
                    {
                      "type": "string",
                      "format": "date"
                    }
                  ]
                },
                {
                  "type": "null"
                }
              ]
            },
            "archived": {
              "type": "boolean"
            },
            "default_branch": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "null"
                }
              ]
            },
            "fork": {
              "type": "boolean"
            },
            "metadata_checked_at": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "date-time"
                },
                {
                  "type": "string",
                  "format": "date"
                }
              ]
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "discovered_at",
        "last_checked_at",
        "source_url",
        "source_file_path",
        "source_commit_sha",
        "query_refs"
      ],
      "properties": {
        "method": {
          "type": "string",
          "minLength": 1
        },
        "discovered_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "string",
              "format": "date"
            }
          ]
        },
        "last_checked_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "string",
              "format": "date"
            }
          ]
        },
        "source_url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https?://"
        },
        "source_file_path": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "source_commit_sha": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "query_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    },
    "structure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "headings",
        "local_items",
        "fingerprint"
      ],
      "properties": {
        "headings": {
          "type": "integer",
          "minimum": 0
        },
        "local_items": {
          "type": "integer",
          "minimum": 0
        },
        "fingerprint": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "link_check": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "checked_at",
        "method",
        "http",
        "reason",
        "redirect_target"
      ],
      "properties": {
        "status": {
          "enum": [
            "active",
            "archived",
            "broken",
            "inaccessible",
            "redirected",
            "needs_review"
          ]
        },
        "checked_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "string",
              "format": "date"
            }
          ]
        },
        "method": {
          "type": "string",
          "minLength": 1
        },
        "http": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "redirect_target": {
          "anyOf": [
            {
              "type": "string",
              "format": "uri",
              "pattern": "^https?://"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "status": {
      "enum": [
        "active",
        "archived",
        "broken",
        "inaccessible",
        "redirected",
        "needs_review"
      ]
    },
    "legacy_v2": {
      "anyOf": [
        {
          "type": "object"
        },
        {
          "type": "null"
        }
      ]
    },
    "risk_level": {
      "enum": [
        "low",
        "high"
      ]
    },
    "screening": {
      "enum": [
        "catalogued",
        "needs_review",
        "screened"
      ]
    },
    "quality_assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "automated_score",
        "editorial_score",
        "score_breakdown",
        "evidence",
        "confidence",
        "limitations",
        "review_status",
        "recommendation"
      ],
      "properties": {
        "automated_score": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "editorial_score": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            },
            {
              "type": "null"
            }
          ]
        },
        "score_breakdown": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "content",
            "credibility",
            "actionability",
            "maintenance",
            "community",
            "metadata"
          ],
          "properties": {
            "content": {
              "type": "integer",
              "minimum": 0,
              "maximum": 25
            },
            "credibility": {
              "type": "integer",
              "minimum": 0,
              "maximum": 25
            },
            "actionability": {
              "type": "integer",
              "minimum": 0,
              "maximum": 20
            },
            "maintenance": {
              "type": "integer",
              "minimum": 0,
              "maximum": 15
            },
            "community": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10
            },
            "metadata": {
              "type": "integer",
              "minimum": 0,
              "maximum": 5
            }
          }
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "confidence": {
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "review_status": {
          "enum": [
            "legacy_v2",
            "source_verified",
            "needs_review",
            "human-approved"
          ]
        },
        "recommendation": {
          "enum": [
            "flagship",
            "recommended",
            "niche",
            "reference-only",
            "needs-review",
            "deprecated"
          ]
        }
      }
    }
  }
}
